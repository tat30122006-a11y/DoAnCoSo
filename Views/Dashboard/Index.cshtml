@model IEnumerable<DoAnCoSo.Models.ViewModels.StockAlertVM>
@{
    ViewData["Title"] = "Bảng Điều Khiển Tồn Kho";

    // Tính toán nhanh các số liệu thống kê ngay trên giao diện để đổ vào các thẻ Card
    int totalAlerts = Model.Count();
    int outOfStockCount = Model.Count(x => x.StockStatusText == "Hết hàng");
    int belowMinCount = Model.Count(x => x.StockStatusText == "Dưới hạn mức");
    int aboveMaxCount = Model.Count(x => x.StockStatusText == "Vượt hạn mức");
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Bảng Điều Khiển Tồn Kho Real-time
            </h1>
            <p class="text-muted small mb-0">Hệ thống tự động giám sát định mức an toàn vật lý của các kho hàng</p>
        </div>
        <div class="text-muted text-end small">
            <i class="bi bi-clock-history me-1"></i>Cập nhật: <span class="fw-bold text-dark">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-start border-primary border-4 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1 small fw-bold">Sản phẩm cần lưu ý</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800 fw-bold">@totalAlerts</div>
                    </div>
                    <div class="fs-1 text-primary opacity-50"><i class="bi bi-box-seam"></i></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-start border-danger border-4 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1 small fw-bold">Sản phẩm hết hàng</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800 fw-bold">@outOfStockCount</div>
                    </div>
                    <div class="fs-1 text-danger opacity-50"><i class="bi bi-x-circle"></i></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-start border-warning border-4 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1 small fw-bold">Dưới hạn mức tối thiểu</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800 fw-bold">@belowMinCount</div>
                    </div>
                    <div class="fs-1 text-warning opacity-50"><i class="bi bi-exclamation-triangle"></i></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 border-start border-info border-4 shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1 small fw-bold">Vượt hạn mức tối đa</div>
                        <div class="h3 mb-0 font-weight-bold text-gray-800 fw-bold">@aboveMaxCount</div>
                    </div>
                    <div class="fs-1 text-info opacity-50"><i class="bi bi-arrow-up-circle"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="card-title mb-0 fs-6 fw-bold"><i class="bi bi-list-ul me-2"></i>Danh Sách Sản Phẩm Vi Phạm Định Mức Tồn</h5>
            <span class="badge bg-secondary">@totalAlerts dòng dữ liệu</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Kho hàng</th>
                            <th class="py-3">Mã SKU</th>
                            <th class="py-3">Tên sản phẩm</th>
                            <th class="text-center py-3">Số lượng tồn</th>
                            <th class="text-center py-3">Định mức an toàn (Min - Max)</th>
                            <th class="text-center pe-4 py-3">Tình trạng vật lý</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                                    Tất cả kho hàng đều ở trạng thái an toàn tuyệt đối!
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                // Định nghĩa CSS Badge màu sắc động dựa trên chữ trạng thái trả về từ SQL View
                                string badgeClass = item.StockStatusText switch
                                {
                                    "Hết hàng" => "bg-danger text-white shadow-sm",
                                    "Dưới hạn mức" => "bg-warning text-dark shadow-sm",
                                    "Vượt hạn mức" => "bg-info text-dark shadow-sm",
                                    "An toàn" => "bg-success text-white shadow-sm",
                                    _ => "bg-secondary text-white"
                                };

                                // Nhấn mạnh hàng nào bị hết sạch hàng
                                string rowClass = item.StockStatusText == "Hết hàng" ? "table-danger opacity-90" : "";

                                <tr class="@rowClass">
                                    <td class="ps-4 fw-semibold text-dark">@item.WarehouseName</td>
                                    <td><code class="text-danger fw-bold">@item.SKU</code></td>
                                    <td>
                                        <div class="fw-bold text-gray-900">@item.ProductName</div>
                                    </td>
                                    <td class="text-center fs-5 fw-bold text-dark">
                                        @item.CurrentStock
                                    </td>
                                    <td class="text-center text-muted small">
                                        <span class="badge bg-light text-dark border">@item.MinQuantity</span>
                                        <span class="mx-1">→</span>
                                        <span class="badge bg-light text-dark border">@item.MaxQuantity</span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <span class="badge @badgeClass rounded-pill px-3 py-2 fw-bold text-uppercase small" style="font-size: 0.75rem;">
                                            @item.StockStatusText
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}