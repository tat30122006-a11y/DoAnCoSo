@using Microsoft.AspNetCore.Http
@using DoAnCoSo.Helpers
@using DoAnCoSo.Models.ViewModels
@{
    // Lấy thông tin user đang đăng nhập từ Session
    var userSession = Context.Session.GetObjectFromJson<UserSessionVM>("UserSession");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoAnCoSo.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            /* Tùy chỉnh màu nền cho header giống phong cách trang quản trị chuyên nghiệp */
            .navbar-custom {
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            }

                .navbar-custom .navbar-brand, .navbar-custom .nav-link {
                    color: #ffffff !important;
                    opacity: 0.9;
                }

                    .navbar-custom .nav-link:hover {
                        opacity: 1;
                        text-shadow: 0 0 5px rgba(255,255,255,0.5);
                    }

            .dropdown-item:active {
                background-color: #1e3c72;
            }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-custom shadow-sm mb-4">
            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-box-seam me-2"></i>WMS SYSTEM
                </a>

                <button class="navbar-toggler bg-white" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @if (userSession != null)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Trang Chủ
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold" href="#" id="masterDataMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-database me-1"></i>Danh Mục
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="masterDataMenu">
                                    <li><a class="dropdown-item" asp-controller="Warehouse" asp-action="Index"><i class="bi bi-house-gear me-2"></i>Kho Bãi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index"><i class="bi bi-box me-2"></i>Hàng Hóa</a></li>

                                    <li><a class="dropdown-item fw-bold text-primary" asp-controller="Inventory" asp-action="Index"><i class="bi bi-box-seam-fill me-2"></i>Xem Tồn Kho Thực Tế</a></li>

                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Supplier" asp-action="Index"><i class="bi bi-truck me-2"></i>Nhà Cung Cấp</a></li>
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Index"><i class="bi bi-people me-2"></i>Khách Hàng</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold" href="#" id="transactionMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-arrow-left-right me-1"></i>Giao Dịch
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="transactionMenu">
                                    <li><a class="dropdown-item" asp-controller="InboundOrder" asp-action="Index"><i class="bi bi-box-arrow-in-right text-success me-2"></i>Nhập Kho</a></li>
                                    <li><a class="dropdown-item" asp-controller="OutboundOrder" asp-action="Index"><i class="bi bi-box-arrow-right text-danger me-2"></i>Xuất Kho</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="TransferOrder" asp-action="Index"><i class="bi bi-shuffle text-primary me-2"></i>Chuyển Kho Nội Bộ</a></li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold" href="#" id="reportMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bar-chart-line me-1"></i>Báo Cáo
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="reportMenu">
                                    <li><a class="dropdown-item" asp-controller="Report" asp-action="DailyLedger"><i class="bi bi-journal-text me-2"></i>Sổ Cái Kho</a></li>
                                    <li><a class="dropdown-item" asp-controller="Report" asp-action="StockLoss"><i class="bi bi-exclamation-octagon me-2"></i>Hàng Hao Hụt</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Report" asp-action="AuditLog"><i class="bi bi-shield-check me-2"></i>Nhật Ký Hệ Thống</a></li>
                                </ul>
                            </li>

                            @if (userSession.Role == "quản lý")
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-warning" asp-controller="User" asp-action="Index">
                                        <i class="bi bi-person-gear me-1"></i>Quản Lý Nhân Viên
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav flex-grow-1"></ul>
                    }

                    <ul class="navbar-nav">
                        @if (userSession != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-bold border border-light rounded-pill px-3" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle align-middle me-1"></i>
                                    @userSession.FullName
                                    <span class="badge bg-light text-dark ms-1 text-uppercase">@userSession.Role</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-item text-danger fw-bold" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-power me-2"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold border border-light rounded px-3" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-3">
        <div class="container-fluid px-4 d-flex justify-content-between small">
            <span>&copy; @DateTime.Now.Year - Đồ Án Cơ Sở - Quản Lý Kho Đa Kho</span>
            <span>Version 1.1.0</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>