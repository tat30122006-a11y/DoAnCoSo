@model IEnumerable<DoAnCoSo.Models.ViewModels.InventoryVM>
@{
    ViewData["Title"] = "Báo Cáo Tồn Kho Thực Tế";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <h4 class="text-primary fw-bold mb-3"><i class="bi bi-box-seam-fill me-2"></i>Tra Cứu Tồn Kho Thực Tế</h4>
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-secondary">Chọn Kho Hàng cần xem</label>
                    <select name="warehouseId" class="form-select">
                        <option value="">-- Tất cả các kho --</option>
                        @foreach (var w in ViewBag.Warehouses)
                        {
                            if (ViewBag.SelectedWarehouseId == w.Id)
                            {
                                <option value="@w.Id" selected>@w.Name</option>
                            }
                            else
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold"><i class="bi bi-search me-1"></i>Xem Tồn Kho</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark small text-uppercase">
                    <tr>
                        <th class="ps-4">Kho Chứa Hàng</th>
                        <th>Mã SKU</th>
                        <th>Tên Sản Phẩm</th>
                        <th class="text-center">Số Lượng Tồn Vật Lý</th>
                        <th class="text-center">Định Mức Tối Thiểu</th>
                        <th class="text-center">Định Mức Tối Đa</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Không có dữ liệu tồn kho nào phù hợp.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@item.WarehouseName</td>
                                <td><code>@item.SKU</code></td>
                                <td class="fw-bold text-dark">@item.ProductName</td>
                                <td class="text-center fs-5 fw-bold @(item.Quantity <= item.MinQuantity ? "text-danger" : "text-success")">
                                    @item.Quantity
                                </td>
                                <td class="text-center text-muted">@item.MinQuantity</td>
                                <td class="text-center text-muted">@item.MaxQuantity</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>