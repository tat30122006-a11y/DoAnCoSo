@model DoAnCoSo.Models.InboundOrder
@using DoAnCoSo.Helpers
@{
    ViewData["Title"] = "Chi Tiết Phiếu Nhập Kho";
}

<div class="container-fluid mt-4">

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show shadow-sm mb-3">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold">
                <i class="bi bi-receipt me-2"></i>Thông Tin Phiếu Nhập: <span class="text-warning">@Model.InboundCode</span>
            </h5>
            @{
                string badgeColor = Model.Status == SystemConstants.OrderStatus.InboundPending ? "bg-warning text-dark" : "bg-success";
            }
            <span class="badge @badgeColor fs-6 px-3 rounded-pill text-uppercase fw-bold">@Model.Status</span>
        </div>

        <div class="card-body p-4">
            <div class="row mb-4 bg-light p-3 rounded border mx-0">
                <div class="col-md-6 border-end">
                    <table class="table table-sm table-borderless mb-0">
                        <tr class="py-1">
                            <td width="150" class="text-muted small">Kho tiếp nhận:</td>
                            <td class="fw-bold text-dark">@Model.Warehouse.Name</td>
                        </tr>
                        <tr class="py-1">
                            <td class="text-muted small">Nhà cung cấp:</td>
                            <td class="fw-bold text-primary">@Model.Supplier.Name</td>
                        </tr>
                        <tr class="py-1">
                            <td class="text-muted small">Ghi chú nội dung:</td>
                            <td class="text-secondary">@(string.IsNullOrEmpty(Model.Note) ? "Không có ghi chú" : Model.Note)</td>
                        </tr>
                    </table>
                </div>
                <div class="col-md-6 ps-md-4">
                    <table class="table table-sm table-borderless mb-0">
                        <tr class="py-1">
                            <td width="150" class="text-muted small">Nhân viên lập phiếu:</td>
                            <td class="fw-bold text-dark">@Model.CreatedByNavigation.FullName</td>
                        </tr>
                        <tr class="py-1">
                            <td class="text-muted small">Thời gian lập phiếu:</td>
                            <td class="text-dark">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                        <tr class="py-1">
                            <td class="text-muted small">Người phê duyệt:</td>
                            <td class="fw-bold text-success">
                                @(Model.ProcessedByNavigation?.FullName ?? "Đang chờ duyệt")
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <h6 class="fw-bold text-dark mb-3 text-uppercase small"><i class="bi bi-box-seam me-2 text-secondary"></i>Danh mục hàng hóa thực nhập</h6>
            <div class="table-responsive mb-4">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th width="6%" class="text-center">STT</th>
                            <th width="15%">Mã SKU</th>
                            <th>Tên Sản Phẩm Hàng Hóa</th>
                            <th width="15%" class="text-end">Số Lượng</th>
                            <th width="18%" class="text-end">Đơn Giá</th>
                            <th width="20%" class="text-end pe-3">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                            decimal totalCartAmount = 0;
                            var orderDetailsList = ViewBag.OrderDetails as List<DoAnCoSo.Models.ViewModels.OrderDetailVM>;
                        }

                        @if (orderDetailsList != null)
                        {
                            foreach (var item in orderDetailsList)
                            {
                                totalCartAmount += item.TotalAmount;
                                <tr>
                                    <td class="text-center text-muted small">@(stt++)</td>
                                    <td><code class="text-danger fw-bold">@item.SKU</code></td>
                                    <td class="fw-bold text-dark">@item.ProductName</td>
                                    <td class="text-end fw-bold">@item.Quantity.ToString("N0")</td>
                                    <td class="text-end text-muted">@item.Price.ToString("N0") đ</td>
                                    <td class="text-end pe-3 fw-bold text-primary">@item.TotalAmount.ToString("N0") đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light border-top-2">
                        <tr class="fw-bold">
                            <td colspan="5" class="text-end py-3 text-dark">TỔNG GIÁ TRỊ PHIẾU NHẬP KHỎ:</td>
                            <td class="text-end pe-3 text-danger fs-5 py-2">@totalCartAmount.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="d-flex justify-content-between border-top pt-3">
                <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                    <i class="bi bi-arrow-left me-1"></i>Quay Lại Danh Sách
                </a>

                @if (Model.Status == SystemConstants.OrderStatus.InboundPending)
                {
                    <form asp-action="Confirm" method="post" onsubmit="return confirm('XÁC NHẬN: Bạn có chắc chắn muốn duyệt nhập kho chính thức cho lô hàng này không? Số lượng tồn kho vật lý dưới database sẽ thay đổi ngay lập tức.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary fw-bold px-4 shadow-sm">
                            <i class="bi bi-check-circle-fill me-2"></i>XÁC NHẬN NHẬP KHO CHÍNH THỨC
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>