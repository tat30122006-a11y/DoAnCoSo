@model DoAnCoSo.Models.ViewModels.WarehouseVM
@{
    ViewData["Title"] = "Cập Nhật Thông Tin Kho Hàng";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="card-title mb-0 fw-bold">
                <i class="bi bi-pencil-square me-2"></i>Cập Nhật Thông Tin Kho Hàng
            </h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold">Tên kho hàng *</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label small fw-bold">Địa chỉ chi tiết</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                    <label class="form-check-label small fw-bold text-secondary" for="isActiveSwitch">
                        Cho phép kho này hoạt động
                    </label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="bi bi-save me-1"></i>Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>