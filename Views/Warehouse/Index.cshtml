@model IEnumerable<DoAnCoSo.Models.ViewModels.WarehouseVM>
@{
    ViewData["Title"] = "Danh Sách Kho Hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="bi bi-house-gear-fill me-2"></i>Quản Lý Kho Hàng</h2>
        <a asp-action="Create" class="btn btn-success fw-bold"><i class="bi bi-plus-circle me-1"></i>Thêm Kho Mới</a>
    </div>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã Kho</th>
                        <th>Tên Kho Hàng</th>
                        <th>Địa Chỉ</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                            <td class="fw-bold text-dark">@item.Name</td>
                            <td>@item.Address</td>
                            <td class="text-center">
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">@item.StatusText</span>
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-bold">
                                    <i class="bi bi-pencil-square me-1"></i>Sửa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>