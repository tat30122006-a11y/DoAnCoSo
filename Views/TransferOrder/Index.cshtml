@model IEnumerable<DoAnCoSo.Models.ViewModels.TransferOrderVM>
@{
    ViewData["Title"] = "Lịch Sử Luân Chuyển Nội Bộ";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="bi bi-shuffle me-2"></i>Phiếu Chuyển Kho Nội Bộ</h2>
        <a asp-action="Create" class="btn btn-primary fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Tạo Lệnh Điều Chuyển
        </a>
    </div>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show shadow-sm">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã Lệnh</th>
                        <th>Ngày Tạo</th>
                        <th class="text-danger"><i class="bi bi-box-arrow-up-right me-1"></i>Kho Xuất (Đi)</th>
                        <th class="text-success"><i class="bi bi-box-arrow-down-right me-1"></i>Kho Nhận (Đến)</th>
                        <th>Người Lập</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có lệnh điều chuyển kho nào.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.TransferCode</td>
                                <td class="small text-muted">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-danger">@item.FromWarehouseName</td>
                                <td class="fw-bold text-success">@item.ToWarehouseName</td>
                                <td><i class="bi bi-person-fill text-muted me-1"></i>@item.CreatedBy</td>
                                <td class="text-center">
                                    @{
                                        // Tô màu động cho 3 trạng thái
                                        string badgeClass = item.Status == "chờ duyệt" ? "bg-warning text-dark" :
                                                            (item.Status == "đang chuyển" ? "bg-info text-dark" : "bg-success");
                                    }
                                    <span class="badge @badgeClass rounded-pill px-3 shadow-sm text-uppercase">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-dark text-white fw-bold shadow-sm">
                                        <i class="bi bi-gear-fill me-1"></i> Xử lý
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>