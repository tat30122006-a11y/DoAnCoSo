@model DoAnCoSo.Models.ViewModels.SupplierVM
@{
    ViewData["Title"] = "Thêm Nhà Cung Cấp";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white py-3">
            <h5 class="card-title mb-0 fw-bold"><i class="bi bi-truck me-2"></i>Thêm Nhà Cung Cấp Mới</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold">Tên đối tác *</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label small fw-bold">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="Address" class="form-label small fw-bold">Địa chỉ</label>
                    <input asp-for="Address" class="form-control" />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-success fw-bold">Lưu Lại</button>
                </div>
            </form>
        </div>
    </div>
</div>