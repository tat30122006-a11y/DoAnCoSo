@model IEnumerable<DoAnCoSo.Models.ViewModels.OutboundOrderVM>
@{
    ViewData["Title"] = "Danh Sách Phiếu Xuất Kho";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger fw-bold"><i class="bi bi-box-arrow-right me-2"></i>Phiếu Xuất Kho</h2>
        <a asp-action="Create" class="btn btn-danger fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Lập Phiếu Xuất Mới
        </a>
    </div>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show shadow-sm">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã Phiếu</th>
                        <th>Thời Gian Tạo</th>
                        <th>Kho Xuất</th>
                        <th>Khách Hàng / Đại Lý</th>
                        <th>Người Lập</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Chưa có phiếu xuất kho nào.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.OutboundCode</td>
                                <td class="small">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-danger">@item.WarehouseName</td>
                                <td class="fw-bold text-primary">@item.CustomerName</td>
                                <td><i class="bi bi-person-fill text-muted me-1"></i>@item.CreatedBy</td>
                                <td class="text-center">
                                    <span class="badge @(item.Status == "chờ xuất" ? "bg-warning text-dark" : "bg-success")">
                                        @item.Status.ToUpper()
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-bold shadow-sm">
                                        <i class="bi bi-eye"></i> Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>