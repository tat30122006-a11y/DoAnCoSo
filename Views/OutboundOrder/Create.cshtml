@{
    ViewData["Title"] = "Lập Phiếu Xuất Kho";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="card-title mb-0 fw-bold">
                <i class="bi bi-file-earmark-minus me-2"></i>Lập Phiếu Xuất Kho Mới
            </h5>
        </div>
        <div class="card-body p-4">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Create" method="post" id="orderForm">
                @Html.AntiForgeryToken()

                <div class="row bg-light p-3 rounded mb-4 border mx-0">
                    <h6 class="fw-bold text-secondary mb-3 text-uppercase small">1. Thông tin chung phiếu xuất</h6>

                    <div class="col-md-4 mb-3">
                        <label class="form-label small fw-bold text-danger">Chọn Kho Xuất Hàng *</label>
                        <select name="warehouseId" class="form-select border-danger" required>
                            <option value="">-- Chọn Kho --</option>
                            @foreach (var w in ViewBag.Warehouses)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label small fw-bold text-primary">Chọn Khách Hàng *</label>
                        <select name="customerId" class="form-select border-primary" required>
                            <option value="">-- Chọn Khách Hàng --</option>
                            @foreach (var c in ViewBag.Customers)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label small fw-bold">Ghi chú nội dung</label>
                        <input name="note" class="form-control" placeholder="Ví dụ: Xuất giao đại lý, bán lẻ..." />
                    </div>
                </div>

                <div class="row bg-light p-3 rounded mb-4 border mx-0">
                    <div class="d-flex justify-content-between align-items-center mb-3 px-0">
                        <h6 class="fw-bold text-secondary mb-0 text-uppercase small">2. Danh mục sản phẩm xuất</h6>
                        <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="addNewRow()">
                            <i class="bi bi-plus-lg me-1"></i>Thêm Sản Phẩm
                        </button>
                    </div>

                    <div class="table-responsive px-0">
                        <table class="table table-bordered table-hover bg-white mb-0" id="detailsTable">
                            <thead class="table-secondary small text-uppercase">
                                <tr>
                                    <th>Tên Sản Phẩm / Mã SKU *</th>
                                    <th width="15%" class="text-center">Số Lượng *</th>
                                    <th width="20%" class="text-center">Đơn Giá Bán (đ) *</th>
                                    <th width="20%" class="text-center">Thành Tiền</th>
                                    <th width="8%" class="text-center">Xóa</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="3" class="text-end py-3">Tổng Tiền Phiếu Xuất:</td>
                                    <td class="text-end text-danger fs-5 py-2" id="grandTotal">0 đ</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between border-top pt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold">
                        <i class="bi bi-arrow-left me-1"></i>Hủy Bỏ & Quay Lại
                    </a>
                    <button type="submit" class="btn btn-danger fw-bold px-4 shadow-sm">
                        <i class="bi bi-save me-2"></i>Lưu Phiếu Nháp
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<select id="productHtmlTemplate" style="display:none;">
    <option value="">-- Chọn Sản Phẩm --</option>
    @foreach (var p in ViewBag.Products)
    {
        <option value="@p.Id">[@p.Sku] - @p.Name</option>
    }
</select>

@section Scripts {
    <script>
        function addNewRow() {
            var productOptions = document.getElementById("productHtmlTemplate").innerHTML;
            var tbody = document.querySelector("#detailsTable tbody");
            var rowId = Date.now();
            var rowHtml = `<tr id="row_${rowId}">
                <td><select name="productIds" class="form-select select-product" required>${productOptions}</select></td>
                <td><input type="number" name="quantities" class="form-control text-center input-qty" min="1" value="1" onchange="calculateRowTotal(this)" onkeyup="calculateRowTotal(this)" required /></td>
                <td><input type="number" name="prices" class="form-control text-end input-price" min="0" value="0" step="500" onchange="calculateRowTotal(this)" onkeyup="calculateRowTotal(this)" required /></td>
                <td class="text-end fw-bold text-primary pt-3 row-total">0 đ</td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow('${rowId}')"><i class="bi bi-trash"></i></button></td>
            </tr>`;
            tbody.insertAdjacentHTML('beforeend', rowHtml);
        }

        function removeRow(rowId) {
            var row = document.getElementById("row_" + rowId);
            if (row) { row.remove(); calculateGrandTotal(); }
        }

        function calculateRowTotal(inputElement) {
            var row = inputElement.closest('tr');
            var qty = parseFloat(row.querySelector('.input-qty').value) || 0;
            var price = parseFloat(row.querySelector('.input-price').value) || 0;
            row.querySelector('.row-total').innerText = (qty * price).toLocaleString('vi-VN') + " đ";
            calculateGrandTotal();
        }

        function calculateGrandTotal() {
            var rows = document.querySelectorAll("#detailsTable tbody tr");
            var grandTotal = 0;
            rows.forEach(function(row) {
                var qty = parseFloat(row.querySelector('.input-qty').value) || 0;
                var price = parseFloat(row.querySelector('.input-price').value) || 0;
                grandTotal += (qty * price);
            });
            document.getElementById("grandTotal").innerText = grandTotal.toLocaleString('vi-VN') + " đ";
        }

        window.onload = function() { addNewRow(); };
    </script>
}