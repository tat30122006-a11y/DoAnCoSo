@model IEnumerable<DoAnCoSo.Models.ViewModels.ProductVM>
@{
    ViewData["Title"] = "Danh Mục Sản Phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="bi bi-box-seam-fill me-2"></i>Danh Mục Hàng Hóa</h2>
        <a asp-action="Create" class="btn btn-success fw-bold"><i class="bi bi-plus-circle me-1"></i>Khai Báo Sản Phẩm</a>
    </div>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã SKU</th>
                        <th>Mã Barcode</th>
                        <th>Tên Hàng Hóa</th>
                        <th>Phân Loại</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4"><code class="text-danger fw-bold">@item.SKU</code></td>
                            <td><span class="text-muted small"><i class="bi bi-barcode me-1"></i>@item.Barcode</span></td>
                            <td class="fw-bold text-dark">@item.Name</td>
                            <td><span class="badge bg-secondary">@item.Category</span></td>
                            <td class="text-center pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary fw-bold">
                                    <i class="bi bi-pencil-square me-1"></i>Sửa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>