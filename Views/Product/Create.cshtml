@model DoAnCoSo.Models.ViewModels.ProductVM
@{
    ViewData["Title"] = "Khai Báo Sản Phẩm Mới";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white py-3">
            <h5 class="card-title mb-0 fw-bold"><i class="bi bi-box-seam me-2"></i>Khai Báo Sản Phẩm Mới</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="SKU" class="form-label small fw-bold">Mã SKU *</label>
                        <input asp-for="SKU" class="form-control" placeholder="VD: IP15-256" required />
                        <span asp-validation-for="SKU" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Barcode" class="form-label small fw-bold">Mã vạch (Barcode)</label>
                        <input asp-for="Barcode" class="form-control" placeholder="Quét mã vạch vào đây..." />
                        <span asp-validation-for="Barcode" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-bold">Tên sản phẩm *</label>
                    <input asp-for="Name" class="form-control" placeholder="VD: iPhone 15 Pro Max 256GB" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Category" class="form-label small fw-bold">Phân loại danh mục *</label>
                    <input asp-for="Category" class="form-control" placeholder="VD: Điện thoại, Laptop, Phụ kiện..." required />
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
                    <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-check-lg me-1"></i>Lưu Sản Phẩm</button>
                </div>
            </form>
        </div>
    </div>
</div>