@model DoAnCoSo.Models.ViewModels.LoginVM
@{
    Layout = null; // Trang Login chạy độc lập, không dùng chung giao diện Layout chính của hệ thống
    ViewData["Title"] = "Đăng Nhập Hệ Thống";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS Warehouse</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            body {
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .card {
                border: none;
                border-radius: 1rem;
            }

            .input-group-text {
                border-right: none;
            }

            .form-control {
                border-left: none;
            }

                .form-control:focus {
                    box-shadow: none;
                    border-color: #dee2e6;
                }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-8 col-md-6 col-lg-4">

                @if (TempData["AlertMessage"] != null)
                {
                    var alertType = TempData["AlertType"]?.ToString() ?? "info";
                    var icon = alertType == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill";

                    <div class="alert alert-@alertType alert-dismissible fade show shadow-sm mb-3" role="alert">
                        <i class="bi @icon me-2"></i> @TempData["AlertMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card shadow-lg p-3">
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <div class="display-4 text-primary mb-2"><i class="bi bi-shield-lock-fill"></i></div>
                            <h4 class="fw-bold text-dark mb-1">HỆ THỐNG WMS</h4>
                            <p class="text-muted small">Đồ án cơ sở Quản lý kho đa kho</p>
                        </div>

                        <form asp-action="Login" method="post">
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label small fw-bold text-secondary">Tên đăng nhập</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="Username" class="form-control bg-light" placeholder="Nhập username..." autocomplete="off" />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password" class="form-label small fw-bold text-secondary">Mật khẩu</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Password" type="password" class="form-control bg-light" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm mb-2">
                                <i class="bi bi-box-arrow-in-right me-2"></i>ĐÁNG NHẬP
                            </button>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-3 text-white-50 small">
                    &copy; @DateTime.Now.Year - Hệ thống Quản Lý Kho Thông Minh
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>