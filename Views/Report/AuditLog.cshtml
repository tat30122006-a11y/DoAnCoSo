@model IEnumerable<DoAnCoSo.Models.ViewModels.AuditLogVM>
@{
    ViewData["Title"] = "Nhật Ký Giám SÁT Hệ Thống";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark fw-bold"><i class="bi bi-shield-check-fill text-success me-2"></i>Nhật Ký Bảo Mật Hệ Thống (Audit Trail)</h2>
        <span class="badge bg-secondary p-2">Chế độ: Chỉ đọc lịch sử</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark small text-uppercase">
                    <tr>
                        <th class="ps-4" width="8%">Mã Log</th>
                        <th width="15%">Thời Gian</th>
                        <th width="15%">Tài Khoản Thao Tác</th>
                        <th width="15%">Hành Động</th>
                        <th width="20%">Bảng Dữ Liệu Tác Động</th>
                        <th class="pe-4">Mã Khóa Gốc (Record ID)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Nhật ký hệ thống hiện tại đang trống.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            string actionBadge = item.Action.ToUpper() switch
                            {
                                "INSERT" => "bg-success",
                                "UPDATE" => "bg-primary",
                                "DELETE" => "bg-danger",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td class="ps-4 text-secondary small">#@item.Id</td>
                                <td class="small">@item.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="fw-bold text-dark"><i class="bi bi-person-badge text-muted me-1"></i>@item.Username</td>
                                <td><span class="badge @actionBadge">@item.Action.ToUpper()</span></td>
                                <td><i class="bi bi-table text-muted me-1"></i><span class="text-secondary fw-semibold">@item.TableName</span></td>
                                <td class="pe-4 fw-bold text-danger">ID: @item.RecordId</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>