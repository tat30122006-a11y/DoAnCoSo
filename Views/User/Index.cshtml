@model IEnumerable<DoAnCoSo.Models.ViewModels.UserVM>
@{
    ViewData["Title"] = "Quản Lý Nhân Viên Hệ Thống";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Tài Khoản Nhân Viên</h2>
        <a asp-action="Create" class="btn btn-dark fw-bold"><i class="bi bi-person-plus-fill me-1"></i>Cấp Tài Khoản Mới</a>
    </div>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show shadow-sm">
            @TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã Số</th>
                        <th>Tài Khoản</th>
                        <th>Họ Và Tên</th>
                        <th>Địa Chỉ Email</th>
                        <th>Chức Vụ</th>
                        <th class="text-center pe-4">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string roleBadge = item.Role == "quản lý" ? "bg-danger" : "bg-primary";
                        <tr>
                            <td class="ps-4 text-secondary small">#@item.Id</td>
                            <td><span class="fw-bold text-dark">@item.Username</span></td>
                            <td class="fw-bold">@item.FullName</td>
                            <td class="text-muted small">@item.Email</td>
                            <td><span class="badge @roleBadge px-3 py-2 text-uppercase">@item.Role</span></td>
                            <td class="text-center pe-4">
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary") rounded-pill px-3 py-1">@item.StatusText</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>