@model IEnumerable<DoAnCoSo.Models.User>
@{
    ViewData["Title"] = "Quản Lý Nhân Viên Hệ Thống";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark fw-bold">
            <i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Tài Khoản Nhân Viên
        </h2>
        <a asp-action="Create" class="btn btn-dark fw-bold">
            <i class="bi bi-person-plus-fill me-1"></i>Cấp Tài Khoản Mới
        </a>
    </div>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i>@TempData["AlertMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark small text-uppercase">
                    <tr>
                        <th class="ps-4" width="8%">Mã Số</th>
                        <th>Tài Khoản</th>
                        <th>Họ Và Tên</th>
                        <th>Địa Chỉ Email</th>
                        <th>Chức Vụ (Role)</th>
                        <th class="text-center pe-4" width="15%">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Chưa có tài khoản nhân viên nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            // Đổi màu sắc badge theo chức vụ công việc
                            string roleBadgeClass = item.Role == "quản lý" ? "bg-danger text-white" : "bg-primary text-white";

                            <tr>
                                <td class="ps-4 text-secondary small">#@item.Id</td>
                                <td><span class="fw-bold text-dark">@item.Username</span></td>
                                <td class="fw-bold">@item.FullName</td>
                                <td class="text-muted small">@item.Email</td>
                                <td>
                                    <span class="badge @roleBadgeClass px-3 py-2 text-uppercase small" style="font-size: 0.75rem;">
                                        @item.Role
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-1">
                                            <i class="bi bi-dash-circle me-1"></i>Khóa
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>